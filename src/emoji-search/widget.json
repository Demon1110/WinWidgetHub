{
  "id": "emoji-search",
  "name": { "zh-TW": "表情搜尋", "zh-CN": "表情搜索", "en": "Emoji search" },
  "description": {
    "zh-TW": "打中文或英文都能找到對應表情，點一下複製；詞庫在本機，不連網",
    "zh-CN": "打中文或英文都能找到对应表情，点一下复制；词库在本机，不联网",
    "en": "Find the right emoji by Chinese or English word and copy it — the dictionary ships locally, no network"
  },
  "version": "1.0.0",
  "date": "2026-11-21",
  "author": "WinWidget",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "other",
  "preview": "preview/{theme}.{lang}.webp",
  "size": { "width": 320, "height": 300, "minWidth": 240, "minHeight": 220, "maxWidth": 760, "maxHeight": 800, "grow": 0.6 },
  "surfaces": ["window"],
  "defaultSurface": "window",
  "window": { "width": 560, "height": 640, "minWidth": 380, "minHeight": 360, "singleInstance": true },
  "permissions": ["clipboard"],
  "settings": [
    { "key": "size", "type": "select", "label": { "zh-TW": "格子大小", "zh-CN": "格子大小", "en": "Cell size" }, "default": "m",
      "options": [
        { "value": "s", "label": { "zh-TW": "小", "zh-CN": "小", "en": "Small" } },
        { "value": "m", "label": { "zh-TW": "中", "zh-CN": "中", "en": "Medium" } },
        { "value": "l", "label": { "zh-TW": "大", "zh-CN": "大", "en": "Large" } }
      ] }
  ]
}
