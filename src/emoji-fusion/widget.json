        { "value": 1024, "label": { "zh-TW": "1024 px", "zh-CN": "1024 px", "en": "1024 px" } }
      ] },
    { "key": "background", "type": "toggle", "label": { "zh-TW": "透明背景", "zh-CN": "透明背景", "en": "Transparent background" }, "default": true }
